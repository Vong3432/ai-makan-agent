# Copy to .env and fill in. Never commit .env.
# How to get the keys: docs/SETUP_KEYS.md

# Server
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Auth: dev (fixed test user, no OAuth) | supabase (OAuth 2.1, P2)
AUTH_MODE=dev
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Supabase (local: values printed by `supabase start`)
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API (New)
GOOGLE_API_KEY=

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Rate limiting — keep false for testing, set true before public launch
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_DAY=30
